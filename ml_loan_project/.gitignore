# Ignore all Jupyter notebook checkpoints in all folders
**/.ipynb_checkpoints/
*.ipynb_checkpoints

# Ignore Anaconda project database files
jupyter-notebook/anaconda_projects/db/
*.db

# Ignore model and scaler files (pickle artifacts)
*.pkl

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Editors/IDEs
.vscode/
.idea/

# OS generated
.DS_Store
Thumbs.db

# Data files (optional)
*.csv
*.tsv
*.xls
*.xlsx
*.h5
*.sqlite
